<?xml version="1.0" encoding="utf-8"?>
<!--
  The platform's packages come from the soft-square-net GitHub Packages feed, which needs a token even for public
  packages: a personal access token (classic) with read:packages, in the environment as GITHUB_PACKAGES_TOKEN
  (CI sets it from the workflow's GITHUB_TOKEN). Everything else comes from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="soft-square-net" value="https://nuget.pkg.github.com/soft-square-net/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="soft-square-net">
      <package pattern="soft.square.net.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <soft-square-net>
      <add key="Username" value="soft-square-net" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </soft-square-net>
  </packageSourceCredentials>
</configuration>
